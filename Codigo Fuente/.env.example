# Copie este archivo como .env (no se versiona) y ajuste los valores.
# Credenciales de DESARROLLO solamente; en cualquier despliegue use valores propios (RNF-15).

FORECAST_ENVIRONMENT=desarrollo
FORECAST_DATABASE_URL=postgresql+psycopg://forecast:forecast@localhost:5432/forecast
FORECAST_CORS_ORIGINS=["http://localhost:3000"]
FORECAST_LOG_LEVEL=INFO

# Docker Compose
POSTGRES_USER=forecast
POSTGRES_PASSWORD=forecast
POSTGRES_DB=forecast

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
