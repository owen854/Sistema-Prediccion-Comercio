# --- Secretos (RNF-15)
.env
.env.local
*.pem

# --- Datos: solo se versionan el manifiesto y las carpetas vacías (RNF-19)
data/**/*
!data/**/
!data/**/.gitkeep
!data/manifest.json

# --- Resultados de experimentos y respaldos
experiments/**/*
!experiments/.gitkeep
backups/

# --- Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- C++ (núcleos OpenMP)
hpc_kernels/build/
*.so
*.o

# --- Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# --- Cuadernos
.ipynb_checkpoints/
